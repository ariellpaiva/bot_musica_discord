DISCORD_TOKEN=cole_o_token_do_bot
# Opcional, faz os comandos aparecerem na hora (botão direito no servidor > Copiar ID)
# GUILD_ID=

# Quem pode usar o /sair (desligar o notebook host): um por linha, apelido = ID do Discord
# (Discord > Configurações > Avançado > Modo desenvolvedor; depois botão direito no usuário > Copiar ID)
# O apelido é só pra você se achar. Linha sem ID é ignorada. Vazio = só o dono do app no Developer Portal
DONO_IDS="
seu_nome =
outra_pessoa =
"

SPOTIFY_CLIENT_ID=xxx
SPOTIFY_CLIENT_SECRET=xxx
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Nome do PC no Spotify (o app oficial aparece com esse nome). Vazio = nome do computador
SPOTIFY_PC_DEVICE=
# Cabo virtual que o bot grava (só muda se o nome do VB-Cable for outro)
# CAPTURE_DEVICE=CABLE Output (VB-Audio Virtual Cable)

# Opcional: os links da JB e da Mix já vêm no código. Só preencha se um dia mudarem
# RADIO_JB_URL=
# RADIO_MIX_URL=
